# Modèle de configuration.
# 1. Copiez ce fichier vers .env
# 2. Remplacez les valeurs vides par vos clés
# 3. Ne versionnez jamais .env : il est ignoré par Git

# Jeton Hugging Face : https://huggingface.co/settings/tokens
# Lu par huggingface_hub et sentence-transformers.
HF_TOKEN=

# Clé optionnelle, seulement si un modèle OpenAI est branché plus tard.
OPENAI_API_KEY=

# Nom public du modèle local. Ce n'est pas une clé secrète.
# Le modèle est téléchargé depuis Hugging Face et exécuté dans Python, par exemple sur Colab.
EDURAG_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Taille maximale d'un PDF envoyé à l'API, en octets. Vide : 20 Mio.
EDURAG_MAX_UPLOAD_BYTES=
